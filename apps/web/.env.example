NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# These tell Clerk where to redirect after sign-in / sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Set to "true" to bypass Clerk entirely and use a per-cookie demo identity.
# Useful when running on a public domain that Clerk dev keys don't allow
# (e.g. tunnels). Each browser session gets its own user/roadmap row.
NEXT_PUBLIC_DEMO_MODE=false
